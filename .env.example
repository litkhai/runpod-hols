# Copy this file to .env and fill in the values. .env is gitignored.
# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 .gitignore 에 등록돼 있다.
#   cp .env.example .env

# Runpod API key — issue at https://console.runpod.io/user/settings under API Keys.
# Used by the SDK, runpodctl, and direct HTTP calls to your endpoint.
# Not needed if you only follow the console-UI parts of the labs.
#
# Runpod API 키 — https://console.runpod.io/user/settings 의 API Keys 에서 발급.
# SDK, runpodctl, 엔드포인트 직접 HTTP 호출에 사용한다.
# 콘솔 UI 로만 실습한다면 없어도 된다.
RUNPOD_API_KEY=

# Serverless endpoint ID — fill in after creating the endpoint.
# Call URL: https://api.runpod.ai/v2/${RUNPOD_ENDPOINT_ID}/runsync
#
# Serverless 엔드포인트 ID — 엔드포인트를 만든 뒤에 채운다.
# 호출 URL: https://api.runpod.ai/v2/${RUNPOD_ENDPOINT_ID}/runsync
RUNPOD_ENDPOINT_ID=

# Docker Hub username — only needed for manual image build/push.
# Not needed if you deploy via the GitHub integration.
#
# Docker Hub 사용자명 — 이미지를 직접 빌드/푸시할 때만 필요.
# GitHub 연동으로 배포하면 필요 없다.
DOCKER_USERNAME=
