# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
# terraform.tfvars 로 복사해서 수정한다. terraform.tfvars 는 gitignore 돼 있다.
#   cp terraform.tfvars.example terraform.tfvars
#
# Note there is no API key here — the provider reads RUNPOD_API_KEY from the
# environment, so no secret ever lands in this file.
#
# 여기에 API 키가 없다는 점에 주목. 프로바이더가 환경변수 RUNPOD_API_KEY 를 읽으므로
# 이 파일에는 비밀값이 들어가지 않는다.

# Required — the image you built and pushed in serverless/01-hello-worker.
# 필수 — serverless/01-hello-worker 에서 빌드해 푸시한 이미지.
image_name = "docker.io/YOUR_DOCKERHUB_USERNAME/hello-worker:v1.0.0"

# Optional overrides / 선택적 재정의

# template_name = "hol-hello-worker-template"
# endpoint_name = "hol-hello-worker"

# Priority-ordered list — Runpod takes the first type with capacity.
# 우선순위 목록 — Runpod 이 용량이 있는 첫 타입을 사용한다.
# gpu_type_ids = ["NVIDIA GeForce RTX 4090", "NVIDIA RTX A4000"]

# container_disk_in_gb = 5
# workers_max          = 2
# idle_timeout         = 5
