# Python / 파이썬
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# Environment — never commit API keys
# 환경변수 — API 키가 들어가므로 절대 커밋하지 않는다
.env
.env.local
.env.bak
*.local

# Terraform
# State can contain secrets in plaintext. The upstream Runpod provider repo
# actually committed a terraform.tfstate by mistake — do not repeat it.
# state 파일에는 비밀값이 평문으로 남을 수 있다. Runpod 공식 프로바이더 레포도
# terraform.tfstate 를 실수로 커밋한 사례가 있으니 반복하지 말 것.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Keep the .example templates, ignore the real ones
# .example 템플릿은 남기고 실제 파일만 무시한다
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraformrc
terraform.rc
# .terraform.lock.hcl is intentionally NOT ignored — it pins provider hashes
# .terraform.lock.hcl 은 의도적으로 무시하지 않는다. 프로바이더 해시를 고정한다

# Editors / OS / 에디터 · OS
.DS_Store
.idea/
.vscode/

# Jekyll / GitHub Pages
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/Gemfile.lock

# Pod lab state — launch.py records the Pod it created so teardown.py needs
# no argument. Machine-local, not source.
# Pod 실습 상태 — launch.py 가 생성한 Pod 을 기록해 teardown.py 가 인자 없이
# 동작하게 한다. 이 머신에만 해당하는 상태이며 소스가 아니다.
**/.pod-id

# Lab artifacts / 실습 중 생성되는 산출물
*.log
outputs/
